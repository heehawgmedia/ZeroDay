# ── Core ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# ── Google Analytics (GA4) ────────────────────────────────────────────────────
GA_PROPERTY_ID=123456789
GA_CREDENTIALS_PATH=/path/to/service-account.json

# ── Google Search Console ─────────────────────────────────────────────────────
# Can reuse the same service account as GA4 if it has Search Console permissions
SEARCH_CONSOLE_CREDENTIALS_PATH=/path/to/service-account.json
SEARCH_CONSOLE_SITE_URL=https://mysite.com/   # default site (with trailing slash)

# ── Notion ────────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...
NOTION_DATABASE_IDS=                          # optional comma-separated DB IDs

# ── Linear ────────────────────────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_...

# ── Trello ────────────────────────────────────────────────────────────────────
TRELLO_API_KEY=...
TRELLO_TOKEN=...

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_AUTH_TOKEN=...                         # Settings → Auth Tokens → Create token
SENTRY_ORG=my-org-slug                        # Your Sentry org slug
SENTRY_PROJECT=my-project-slug                # Default project (sites can override)

# ── PageSpeed Insights ────────────────────────────────────────────────────────
PAGESPEED_API_KEY=                            # optional; works without it, but rate-limited

# ── Poller schedule (seconds) ─────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=300                     # health checks every 5 min
SENTRY_INTERVAL_SECONDS=900                   # sentry every 15 min
PAGESPEED_INTERVAL_SECONDS=3600               # pagespeed every 1 hr

# ── File Access ───────────────────────────────────────────────────────────────
ALLOWED_FILE_PATHS=/home/user/ZeroDay,/home/user/projects
