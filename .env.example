# ── Core ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=your-github-username

# ── Google Analytics (GA4) ───────────────────────────────────────────────────
# Path to a service-account JSON credentials file
GA_PROPERTY_ID=123456789
GA_CREDENTIALS_PATH=/path/to/service-account.json

# ── Notion ───────────────────────────────────────────────────────────────────
NOTION_TOKEN=secret_...
# Comma-separated database IDs to track (leave blank to auto-discover)
NOTION_DATABASE_IDS=

# ── Linear ───────────────────────────────────────────────────────────────────
LINEAR_API_KEY=lin_api_...

# ── Trello ───────────────────────────────────────────────────────────────────
TRELLO_API_KEY=...
TRELLO_TOKEN=...

# ── File Access ──────────────────────────────────────────────────────────────
# Comma-separated absolute paths Jarvis is allowed to read
ALLOWED_FILE_PATHS=/home/user/ZeroDay,/home/user/projects
